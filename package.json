{
  "name": "crossdoc",
  "version": "0.1.0",
  "description": "Evidence-grounded document consistency review agent built on Pi.",
  "type": "module",
  "bin": {
    "crossdoc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:web": "tsx src/server.ts",
    "review": "tsx src/cli.ts review",
    "start:web": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "document-review",
    "consistency",
    "agent",
    "pi",
    "pdf"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "express": "5.3.0",
    "multer": "2.4.0",
    "typebox": "^1.3.27",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^24.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
