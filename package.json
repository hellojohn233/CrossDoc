{
  "name": "crossdoc",
  "version": "0.1.0",
  "description": "Evidence-grounded document consistency review agent built on Pi.",
  "type": "module",
  "bin": {
    "crossdoc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:web": "tsx src/server.ts",
    "review": "tsx src/cli.ts review",
    "start:web": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:agent": "tsx scripts/verify-agent.mjs",
    "verify:agent-parallel": "tsx scripts/verify-agent-parallel.mjs",
    "verify:conflict-diff": "node scripts/verify-conflict-diff.mjs",
    "verify:review-semantics": "tsx scripts/verify-review-semantics.mjs",
    "verify:skills": "tsx scripts/verify-skills.mjs",
    "verify:user-skills": "tsx scripts/verify-user-skills.mjs",
    "verify:web-read": "tsx scripts/verify-web-read.mjs",
    "verify:review-library": "tsx scripts/verify-review-library.mjs",
    "verify:library-identity": "tsx scripts/verify-library-identity.mjs",
    "verify:library-groups": "tsx scripts/verify-library-groups.mjs",
    "verify:library-delete": "tsx scripts/verify-library-delete.mjs",
    "verify:pdf-page-render": "tsx scripts/verify-pdf-page-render.mjs",
    "verify:pdf-vector-classification": "tsx scripts/verify-pdf-vector-classification.mjs",
    "verify:document-search": "tsx scripts/verify-document-search.mjs",
    "verify:document-ingest": "tsx scripts/verify-document-ingest.mjs",
    "verify:scan-page-blocks": "tsx scripts/verify-scan-page-blocks.mjs",
    "verify:storage": "tsx scripts/verify-storage.mjs",
    "examples:generate": "tsx scripts/generate-examples.mjs"
  },
  "keywords": [
    "document-review",
    "consistency",
    "agent",
    "pi",
    "pdf"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@napi-rs/canvas": "1.0.11",
    "better-sqlite3": "12.11.1",
    "express": "5.3.0",
    "multer": "2.4.0",
    "pdfjs-dist": "6.3.289",
    "typebox": "^1.3.27",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^24.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
